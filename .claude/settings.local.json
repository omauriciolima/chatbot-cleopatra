{
  "permissions": {
    "allow": [
      "PowerShell(Get-ChildItem -Force -ErrorAction SilentlyContinue | Format-Table -AutoSize; Write-Host \"---\"; \\(Get-ChildItem -Force -ErrorAction SilentlyContinue\\).Count)",
      "PowerShell(npm install *)",
      "PowerShell(Get-ChildItem -Recurse -File | Where-Object { $_.FullName -notmatch 'node_modules' -and $_.FullName -notmatch '\\\\.claude' } | Select-Object -ExpandProperty FullName | Sort-Object)",
      "PowerShell(git *)",
      "Bash(git init *)",
      "Bash(git add *)"
    ]
  }
}

# ==========================================
# Evolution API (WhatsApp)
# ==========================================
# URL base da instância da Evolution API
EVOLUTION_BASE_URL=
# Nome da instância criada na Evolution API
EVOLUTION_INSTANCE=
# API Key de autenticação da Evolution API
EVOLUTION_API_KEY=

# Número de WhatsApp da manicure/dona do salão, que recebe os comandos
# administrativos ("agenda hoje", "agenda amanhã", "cancelar [nome]", "atraso [min]min").
# Formato: DDI + DDD + número, apenas dígitos. Ex: 5511999999999
NUMERO_MANICURE=

# ==========================================
# Google Sheets
# ==========================================
# ID da planilha (fica na URL entre /d/ e /edit)
GOOGLE_SHEETS_ID=
# Caminho do arquivo JSON da conta de serviço (Service Account) baixado no Google
# Cloud Console. Coloque o arquivo na raiz do projeto — ele já está no .gitignore
# (padrão "credentials*.json"), então nunca é enviado ao GitHub.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# ==========================================
# Servidor
# ==========================================
# Porta em que o servidor Express vai rodar (Railway define automaticamente)
PORT=3000

# Nome do salão, usado nas mensagens do bot
NOME_SALAO=Espaço Cleópatra

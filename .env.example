# ==========================================
# Z-API (WhatsApp)
# ==========================================
# ID da instância criada no painel da Z-API (https://app.z-api.io)
ZAPI_INSTANCE_ID=
# Token da instância
ZAPI_TOKEN=
# Client-Token de segurança da conta Z-API (aba "Segurança" do painel)
ZAPI_CLIENT_TOKEN=

# Número de WhatsApp da manicure/dona do salão, que recebe os comandos
# administrativos ("agenda hoje", "agenda amanhã", "cancelar [nome]").
# Formato: DDI + DDD + número, apenas dígitos. Ex: 5511999999999
NUMERO_MANICURE=

# ==========================================
# Google Sheets
# ==========================================
# ID da planilha (fica na URL entre /d/ e /edit)
GOOGLE_SHEET_ID=
# E-mail da conta de serviço (Service Account) do Google Cloud
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chave privada da conta de serviço (mantenha as aspas e os \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==========================================
# Servidor
# ==========================================
# Porta em que o servidor Express vai rodar (Railway define automaticamente)
PORT=3000

# Nome do salão, usado nas mensagens do bot
NOME_SALAO=Espaço Cleópatra
